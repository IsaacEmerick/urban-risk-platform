@startuml sequencia
title Fluxo de recebimento e disparo de um alerta
autonumber
' Participantes com os mesmos nomes do glossário e do diagrama de arquitetura.
participant "Sensor" as S
participant "API Gateway" as GW
participant "Identidade e Consentimento\n(LGPD)" as IAM
participant "Serviço de Ingestão" as ING
queue "Broker de Eventos" as BR
participant "Serviço de Validação" as VAL
participant "Motor de Confiança" as CONF
participant "Motor de Classificação de Risco" as RISK
participant "Gerenciador de Eventos" as EV
database "Eventos + geodados\n(PostgreSQL/PostGIS)" as DB
participant "Serviço de Notificação" as NOT
participant "App do Morador" as APP
participant "Painel do Agente / Operador" as PAINEL
actor "Carlos\n(agente da Defesa Civil)" as AG
actor "Ana\n(moradora)" as M

S -> GW : enviarDado(leitura, origem, timestamp)
GW -> IAM : autenticar(origem)
IAM --> GW : origem autenticada
GW -> ING : encaminhar(leitura)
ING -> ING : normalizar e pseudonimizar dados pessoais
note over ING : Base pública: coletada pelo Serviço de Ingestão\n(coleta agendada); daqui em diante o fluxo é o mesmo
ING -> BR : publicar(DadoRecebido)
ING --> GW : 202 Accepted
GW --> S : 202 Accepted

BR -> VAL : consumir(DadoRecebido)
VAL -> VAL : checar formato, faixa e duplicidade
alt dado inválido
  VAL -> DB : registrar(descartado, motivo)
else dado válido
  VAL -> CONF : calcularConfianca(dado)
  CONF -> DB : buscarCorroboracoes(raio 500 m, janela 30 min)
  DB --> CONF : dados próximos
  CONF --> VAL : confiança (ex.: 80, Alta)
  VAL -> RISK : classificarRisco(dado)
  RISK --> VAL : nível de risco (ex.: Alto)
  VAL -> EV : criarOuAtualizarEvento(dado, risco, confiança)
  note right of EV : RN04 agrupa dados do mesmo tipo\n(300 m, 60 min); RN07 usa o maior\nrisco e a maior confiança do grupo
  EV -> DB : salvar(evento, estado = Reportado)

  alt confiança >= 75 (RN01)
    EV -> EV : estado = Confirmado
  else 50 <= confiança < 75 (RN02)
    EV -> EV : estado = Em validação
    AG -> PAINEL : abrir Fila de validação
    PAINEL -> GW : listarEventos(estado = Em validação)
    GW -> EV : listarEventos(estado = Em validação)
    EV --> GW : eventos por prioridade
    GW --> PAINEL : eventos por prioridade
    AG -> PAINEL : Confirmar(evento)
    PAINEL -> GW : agenteConfirma(evento)
    GW -> EV : agenteConfirma(evento)
    EV -> EV : estado = Confirmado
  else confiança < 50 (RN03)
    EV -> EV : permanece Reportado (aguarda confirmações por até 2 h)
  end

  opt estado = Confirmado e risco >= Alto
    EV -> EV : estado = Alerta emitido
    EV -> BR : publicar(AlertaEmitido)
    BR -> NOT : consumir(AlertaEmitido)
    NOT -> DB : buscarUsuarios(raio afetado, áreas de interesse, consentimento ativo)
    DB --> NOT : usuários com área afetada e consentimento ativo (RN06)
    NOT -> APP : enviarPush("Alagamento - risco Alto")
    APP -> M : exibir notificação
    NOT -> DB : registrarNotificacao(usuário, alerta)
    NOT -> BR : publicar(NotificacaoEnviada)
    BR -> EV : consumir(NotificacaoEnviada)
    EV -> EV : estado = Em monitoramento
  end
end
@enduml
