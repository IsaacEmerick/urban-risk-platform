@startuml arquitetura
title Arquitetura em camadas - Urban Risk Intelligence Platform
skinparam componentStyle rectangle

package "Fontes externas" {
  [Sensor\n(nível d'água, chuva, temperatura)] as S
  [Base pública\n(CEMADEN, INMET, Defesa Civil, concessionárias)] as API
  [Comunidade\n(registros pelo app)] as COM
}

package "Camada de Apresentação" {
  [App do Morador (web/mobile)] as APP
  [Painel do Agente / Operador] as PAINEL
  [Central de Notificações] as CNUI
}

package "Camada de Aplicação / Negócio" {
  [API Gateway\n(autenticação, rate limit)] as GW
  [Serviço de Ingestão] as ING
  queue "Broker de Eventos\n(processamento de eventos)" as BR
  [Serviço de Validação] as VAL
  [Motor de Confiança] as CONF
  [Motor de Classificação de Risco] as RISK
  [Gerenciador de Eventos\n(máquina de estados)] as EV
  [Serviço de Notificação\n(push, SMS, e-mail)] as NOT
  [Serviço de Análises] as ANA
  [Identidade e Consentimento\n(LGPD)] as IAM
}

package "Camada de Dados" {
  database "Eventos + geodados\n(PostgreSQL/PostGIS)" as DB
  database "Séries temporais\n(TimescaleDB)" as TS
  database "Cofre de dados pessoais\n(criptografado)" as PII
  database "Logs de auditoria" as LOG
  database "Cache (Redis)" as CACHE
}

COM --> APP : registra ocorrência
S --> GW : envia leituras
ING --> API : coleta agendada
APP --> GW
PAINEL --> GW
CNUI --> GW
GW --> IAM : autentica
GW --> ING
GW --> CACHE
ING --> BR : publica DadoRecebido
ING --> TS
BR --> VAL
VAL --> CONF
VAL --> RISK
VAL --> EV
CONF --> DB : busca corroborações
EV --> DB
EV --> BR : publica AlertaEmitido
BR --> NOT
NOT --> DB : busca usuários e registra notificação
NOT --> APP : push
NOT --> CNUI : entrega notificação
ANA --> DB
ANA --> TS
IAM --> PII
IAM --> LOG

note right of PII
  Dados pessoais separados dos eventos.
  Eventos guardam apenas ID pseudonimizado.
end note
@enduml
